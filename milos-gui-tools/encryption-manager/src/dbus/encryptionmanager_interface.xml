<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-Bus Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.milos.EncryptionManager">
    <!-- Existing single-file encryption method -->
    <method name="EncryptFile">
      <arg name="path" type="s" direction="in"/>
      <arg name="algorithm" type="s" direction="in"/>
      <arg name="key_id" type="s" direction="in"/>
      <arg name="operation_id" type="s" direction="out"/>
    </method>
    
    <!-- New batch encryption method -->
    <method name="EncryptFiles">
      <arg name="paths" type="as" direction="in"/>
      <arg name="algorithm" type="s" direction="in"/>
      <arg name="key_id" type="s" direction="in"/>
      <arg name="operation_id" type="s" direction="out"/>
    </method>
    
    <!-- Existing signals -->
    <signal name="EncryptionStarted">
      <arg name="operation_id" type="s"/>
    </signal>
    
    <signal name="EncryptionProgress">
      <arg name="operation_id" type="s"/>
      <arg name="percentage" type="i"/>
    </signal>
    
    <signal name="EncryptionCompleted">
      <arg name="operation_id" type="s"/>
      <arg name="status" type="s"/>
    </signal>
    
    <signal name="EncryptionError">
      <arg name="operation_id" type="s"/>
      <arg name="error" type="s"/>
    </signal>
    
    <!-- Optional batch operation signals -->
    <signal name="BatchEncryptionStarted">
      <arg name="operation_id" type="s"/>
    </signal>
    
    <signal name="BatchEncryptionProgress">
      <arg name="operation_id" type="s"/>
      <arg name="file_index" type="i"/>
      <arg name="percentage" type="i"/>
    </signal>
    
    <signal name="BatchEncryptionCompleted">
      <arg name="operation_id" type="s"/>
      <arg name="status" type="s"/>
    </signal>
    
    <!-- Error definitions -->
    <annotation name="org.freedesktop.DBus.Error.Name" value="org.milos.EncryptionManager.Error"/>
    <annotation name="org.freedesktop.DBus.Error.InvalidPath" value="org.milos.EncryptionManager.Error.InvalidPath"/>
    <annotation name="org.freedesktop.DBus.Error.InvalidAlgorithm" value="org.milos.EncryptionManager.Error.InvalidAlgorithm"/>
    <annotation name="org.freedesktop.DBus.Error.InvalidKey" value="org.milos.EncryptionManager.Error.InvalidKey"/>
    <annotation name="org.freedesktop.DBus.Error.TooManyFiles" value="org.milos.EncryptionManager.Error.TooManyFiles"/>
  </interface>
</node>

