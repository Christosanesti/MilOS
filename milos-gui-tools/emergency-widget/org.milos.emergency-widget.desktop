[Desktop Entry]
Name=MilOS Emergency Actions Widget
Comment=Always-visible emergency action buttons for critical security operations
Icon=security-high
Type=Service
X-KDE-ServiceTypes=Plasma/Applet
X-KDE-PluginInfo-Name=org.milos.emergency-widget
X-KDE-PluginInfo-Category=System Information
X-KDE-PluginInfo-License=GPL-3.0-or-later
X-KDE-PluginInfo-Website=https://milos.security
X-KDE-PluginInfo-RequiredPermissions=admin
X-KDE-PluginInfo-Locked=true
X-Plasma-API=declarativeappletscript
X-Plasma-MainScript=ui/main.qml














