# MilOS Personnel Scheduler Configuration

# Device configurations
devices:
  # Face recognition device example
  /dev/video0:
    vendor: "Generic"
    model: "USB Camera"
    settings:
      resolution: "640x480"
      fps: 30
  
  # Fingerprint scanner example
  fingerprint_0:
    vendor: "Generic"
    model: "Fingerprint Scanner"
    settings:
      sensitivity: "medium"
      timeout: 5000

# Health monitoring settings
health_monitoring:
  check_interval_ms: 10000
  error_threshold: 3

# Audit logging settings
audit:
  enabled: true
  log_all_operations: true

