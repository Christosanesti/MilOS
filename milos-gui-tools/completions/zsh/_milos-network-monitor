#compdef milos-network-monitor
# zsh completion for milos-network-monitor

_milos_network_monitor() {
    local context state line
    local -a commands

    commands=(
        'capture:Start/stop packet capture'
        'analyze:Analyze network traffic'
        'threats:Display threat information'
        'ids-config:Manage IDS configuration'
        'topology:Display network topology'
    )

    _arguments -C \
        "1: :->command" \
        "*::arg:->args"

    case $state in
        command)
            _describe 'command' commands
            ;;
        args)
            case $words[1] in
                capture)
                    _arguments \
                        '(-i --interface)'{-i,--interface}'[Network interface]:interface:->interfaces' \
                        '(-f --filter)'{-f,--filter}'[BPF filter]' \
                        '--start[Start capture]' \
                        '--stop[Stop capture]' \
                        '--stats[Show statistics]'
                    ;;
                analyze)
                    _arguments \
                        '(-f --file)'{-f,--file}'[Input file]:file:_files' \
                        '--format[Output format]' \
                        '--json[JSON output]'
                    ;;
                threats)
                    _arguments \
                        '--severity[Filter by severity]' \
                        '--format[Output format]' \
                        '--json[JSON output]'
                    ;;
                ids-config)
                    _arguments \
                        '(-f --file)'{-f,--file}'[Configuration file]:file:_files' \
                        '--show[Show current configuration]' \
                        '--reload[Reload configuration]'
                    ;;
                topology)
                    _arguments \
                        '--format[Output format]' \
                        '--json[JSON output]'
                    ;;
            esac
            ;;
    esac

    case $state in
        interfaces)
            local -a interfaces
            if command -v ip &> /dev/null; then
                interfaces=($(ip -o link show | awk -F': ' '{print $2}'))
            elif command -v ifconfig &> /dev/null; then
                interfaces=($(ifconfig -s | awk '{print $1}' | tail -n +2))
            fi
            _describe 'interface' interfaces
            ;;
    esac
}

_milos_network_monitor "$@"

