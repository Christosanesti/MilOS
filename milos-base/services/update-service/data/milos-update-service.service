[Unit]
Description=MilOS Update Service
Documentation=https://milos.security/docs/services/update-service
After=network.target
Wants=network.target
Requires=network.target

[Service]
Type=notify
ExecStart=/usr/bin/milos-update-service-daemon
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=10s
WatchdogSec=60s

# Security hardening
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Capabilities (required for package management operations)
# Note: Package management operations may require elevated privileges
# This should be carefully reviewed and restricted as much as possible
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE
AmbientCapabilities=

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=milos-update-service

# Notify systemd when ready
NotifyAccess=all

[Install]
WantedBy=multi-user.target

